 {"do":"settings","type_method":"keys"},
 {"do":"note","text":"held Shift from keydown, then type: the text must stay lowercase"},
 {"do":"act","action":{"action_type":"keydown","action_inputs":{"key":"shift"}}},
 {"do":"act","action":{"action_type":"type","action_inputs":{"content":"abc"}}},
 {"do":"act","action":{"action_type":"keyup","action_inputs":{"key":"shift"}}},
 {"do":"act","action":{"action_type":"hotkey","action_inputs":{"hotkey":"ctrl a"}}},
 {"do":"act","action":{"action_type":"hotkey","action_inputs":{"hotkey":"ctrl+end"}}},
 {"do":"act","action":{"action_type":"hotkey","action_inputs":{"key":"shift home"}}},
 {"do":"act","action":{"action_type":"keydown","action_inputs":{"key":"ctrl"}}},
 {"do":"release"},
 {"do":"act","action":{"action_type":"scroll","action_inputs":{"start_box":"@list","direction":"down"}}},
 {"do":"sleep","ms":400},
 {"do":"act","action":{"action_type":"scroll","action_inputs":{"start_box":"@list","direction":"up"}}},
 {"do":"sleep","ms":400},
 {"do":"act","action":{"action_type":"scroll","action_inputs":{"start_box":"@hscroll","direction":"right"}}},
 {"do":"sleep","ms":400},
 {"do":"act","action":{"action_type":"drag","action_inputs":{"start_box":"@dragfrom","end_box":"@dropto"}}},
 {"do":"act","action":{"action_type":"wait","action_inputs":{"seconds":0.5}}},
 {"do":"observe","save":"after-actions"},
 {"do":"note","text":"a window Reparo opens: it shows up on the monitor, nothing to follow"},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@open"}}},
 {"do":"sleep","ms":800},
 {"do":"observe","save":"dialog"},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@dialogok"}}},
 {"do":"note","text":"rejections"},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":[5000, 10]}}},
 {"do":"act","action":{"action_type":"hotkey","action_inputs":{"hotkey":"ctrl foo"}}},
 {"do":"act","action":{"action_type":"scroll","action_inputs":{"start_box":"@list","direction":"sideways"}}},
 {"do":"act","action":{"action_type":"fly","action_inputs":{}}},
 {"do":"note","text":"the app's window closes: the screen stays, the Recovery goes on"},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@quit"}}},
 {"do":"sleep","ms":800},
 {"do":"observe","save":"app-closed"}
