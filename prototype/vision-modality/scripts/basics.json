[
 {"do":"note","text":"A: every Recovery action at 100%, typing keys/unicode/paste, a dialog Reparo opens"},
 {"do":"info"},
 {"do":"session"},
 {"do":"observe","save":"start"},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@click"}}},
 {"do":"act","action":{"action_type":"click","action_inputs":{"start_box":"@click#"}}},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@click%"}}},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@tiny"}}},
 {"do":"act","action":{"action_type":"left_double","action_inputs":{"start_box":"@double"}}},
 {"do":"act","action":{"action_type":"right_single","action_inputs":{"start_box":"@right"}}},
 {"do":"act","action":{"action_type":"hover","action_inputs":{"start_box":"@hover"}}},
 {"do":"act","action":{"action_type":"left_single","action_inputs":{"start_box":"@text"}}},
 {"do":"note","text":"type_method keys (default): scan codes where the Spanish layout has the char, VK_PACKET otherwise"},
 {"do":"act","action":{"action_type":"type","action_inputs":{"content":"Hola ñandú @ 5€ ¿é? 漢字 😀\n"}}},
 {"do":"settings","type_method":"unicode"},
 {"do":"act","action":{"action_type":"type","action_inputs":{"content":"Unicode ñ@€é漢😀\n"}}},
