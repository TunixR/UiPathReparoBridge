<!-- PROTOTYPE for ReparoHome#66, extended for #67: throwaway, never merged. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>Reparo.UiPathBridge</RootNamespace>
    <PackageId>Reparo.UiPathBridge.Activities</PackageId>
    <Version>0.0.1-proto.67.2</Version>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Authors>Reparo prototype</Authors>
    <Description>PROTOTYPE of the UiPath Bridge's Event-level Recovery inside a Use Application card (ReparoHome#66, extended for #67).</Description>
